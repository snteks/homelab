# ============================================================
# DO NOT COMMIT THIS FILE WITH REAL VALUES.
# Apply the real secret manually (out-of-band) — never store
# plaintext secrets in Git. See README §Secret Management.
# ============================================================
#
# Usage:
#   cp secret.yaml.example secret.yaml
#   # edit secret.yaml with your real values
#   kubectl apply -f secret.yaml
#   rm secret.yaml   # or keep locally, outside the repo
#
# Add secret.yaml to your .gitignore if you store it locally.
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: actual-server-secret
  namespace: actual
type: Opaque
stringData:
  # The password users will enter at the Actual Budget login screen.
  # Use a strong random value: openssl rand -base64 32
  ACTUAL_SERVER_PASSWORD: "REPLACE_ME"
